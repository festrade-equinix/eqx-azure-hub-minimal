# Equinix Fabric
export TF_VAR_equinix_client_id="your-client-id"
export TF_VAR_equinix_client_secret="your-client-secret"

# BGP auth key (optional MD5)
# export TF_VAR_bgp_auth_key="your-md5-key"

# Azure
export TF_VAR_azure_subscription_id="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# export TF_VAR_azure_tenant_id="..."
# export TF_VAR_azure_client_id="..."
# export TF_VAR_azure_client_secret="..."

# VM admin SSH public key
export TF_VAR_admin_ssh_public_key="ssh-rsa AAAAB3Nza...your-key... comment"
